              <property name="styleSheet">
               <string notr="true">QPushButton {
    background-color: red;
    color: white;
    border-radius: 10px; /* 设置圆角半径 */
    font-family: 'Microsoft YaHei'; /* 设置字体为微软雅黑 */
    padding: 3px 5px; /* 设置内边距，使按钮看起来更美观 */
border: 2px solid transparent; /* 设置边框为透明 */
}

QPushButton:hover {
    background-color: rgb(170, 0, 0); /* 设置鼠标悬停时的背景颜色 */
}

QPushButton:pressed {
    background-color: rgb(85, 85, 127); /* 设置按钮按下时的背景颜色 */
}</string>

build-recording/

# Writable application databases must never be committed.
/data/*.db
/data/*.db-*
/.release-validation
/ocr_models/
/wxocr/

# Reproducible local development/runtime files
.runtime-tools/
runtime/
validation/

.build-python/
.venv-build/

# Optional local Agent weights and runtime
.agent-runtime/

# Private Agent API is maintained in a separate private repository
.private-agent/
private_agent/
anclicker_private_agent/
*.private.*

# Consolidated local dependencies, historical builds and validation evidence.
/.local/
/artifacts/

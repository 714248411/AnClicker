.idea/
*.egg-info/
build/
dist/
build-verification/
dist-verification/
release/
images/!/test.png
!/Clicker.build/
!/Clicker.onefile-build/
!/Clicker.dist/

__pycache__/
.venv/
.pytest_cache/
.DS_Store
Window/__pycache__/
EXE_TEST/

Clicker-test-file/

# Clicker runtime data. Keep the portable database template.
/data/images/*
!/data/images/.gitkeep
/data/exports/*
!/data/exports/.gitkeep
/data/logs/*
!/data/logs/.gitkeep
/data/temp/*
!/data/temp/.gitkeep

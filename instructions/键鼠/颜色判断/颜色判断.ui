<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0"><class>InstructionEditor</class><widget class="QDialog" name="InstructionEditor">
<property name="windowTitle"><string>颜色判断</string></property>
<property name="geometry"><rect><x>0</x><y>0</y><width>700</width><height>560</height></rect></property>
<layout class="QVBoxLayout" name="rootLayout">
<item><widget class="QLabel" name="titleLabel"><property name="text"><string>颜色判断（右侧：是，上方：否）</string></property></widget></item>
<item><widget class="QGroupBox" name="parameterGroupBox"><property name="title"><string>颜色判断参数</string></property><layout class="QFormLayout" name="parameterFormLayout">
<item row="0" column="0"><widget class="QLabel" name="label0"><property name="text"><string>检测坐标 x,y</string></property></widget></item>
<item row="0" column="1"><layout class="QHBoxLayout" name="row0"><item><widget class="QLineEdit" name="parameter_0"><property name="text"><string>0,0</string></property></widget></item><item><widget class="QPushButton" name="auxiliary_0"><property name="text"><string>获取坐标</string></property></widget></item></layout></item>
<item row="1" column="0"><widget class="QLabel" name="label1"><property name="text"><string>颜色 #RRGGBB 或 R,G,B</string></property></widget></item>
<item row="1" column="1"><layout class="QHBoxLayout" name="row1"><item><widget class="QLineEdit" name="parameter_1"><property name="text"><string>#FFFFFF</string></property></widget></item><item><widget class="QPushButton" name="auxiliary_1"><property name="text"><string>选择颜色</string></property></widget></item></layout></item>
<item row="2" column="0"><widget class="QLabel" name="label2"><property name="text"><string>RGB 单通道容差（0–255）</string></property></widget></item>
<item row="2" column="1"><widget class="QSpinBox" name="parameter_2"><property name="maximum"><number>255</number></property></widget></item>
<item row="3" column="0"><widget class="QLabel" name="label3"><property name="text"><string>判断方式</string></property></widget></item>
<item row="3" column="1"><widget class="QComboBox" name="parameter_3"><item><property name="text"><string>相等</string></property></item><item><property name="text"><string>不相等</string></property></item></widget></item>
<item row="4" column="0"><widget class="QLabel" name="label4"><property name="text"><string>结果变量（可选）</string></property></widget></item>
<item row="4" column="1"><layout class="QHBoxLayout" name="row4"><item><widget class="QComboBox" name="parameter_4"><property name="editable"><bool>true</bool></property></widget></item><item><widget class="QPushButton" name="auxiliary_4"><property name="text"><string>设置变量</string></property></widget></item></layout></item>
</layout></widget></item>
<item><widget class="QLabel" name="hint"><property name="text"><string>容差 0 为完全一致；无连线时记录结果后继续，分支连线与条件判断相同。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><widget class="QGroupBox" name="commonGroupBox"><property name="title"><string>通用参数</string></property><layout class="QFormLayout" name="commonFormLayout">
<item row="0" column="0"><widget class="QLabel" name="repeatLabel"><property name="text"><string>重复次数</string></property></widget></item><item row="0" column="1"><widget class="QSpinBox" name="repeatSpinBox"><property name="minimum"><number>1</number></property><property name="maximum"><number>999999</number></property></widget></item>
<item row="1" column="0"><widget class="QLabel" name="errorLabel"><property name="text"><string>异常处理</string></property></widget></item><item row="1" column="1"><widget class="QComboBox" name="errorPolicyComboBox"><item><property name="text"><string>提示异常并暂停</string></property></item><item><property name="text"><string>提示异常并停止</string></property></item><item><property name="text"><string>自动跳过</string></property></item></widget></item>
<item row="2" column="0"><widget class="QLabel" name="noteLabel"><property name="text"><string>备注</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="noteEdit"/></item>
</layout></widget></item>
<item><layout class="QHBoxLayout" name="footer"><item><widget class="QPushButton" name="testButton"><property name="text"><string>测试指令</string></property></widget></item><item><widget class="QDialogButtonBox" name="buttonBox"><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget></item></layout></item>
</layout></widget><resources/><connections/></ui>
